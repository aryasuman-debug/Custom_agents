{
	"servers": {
		"io.github.github/github-mcp-server": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"gallery": "https://api.mcp.github.com",
			"version": "1.0.0"
		},
		"filesystem": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@modelcontextprotocol/server-filesystem",
				"C:\\Users\\-\\Desktop"
			]
		},


    "jira": {
            "type": "stdio",
            "command": "npx",
            "args": ["-y", "@atlassian-dc-mcp/jira"],
            "env": {
                "JIRA_HOST": "jiraeu.epam.com",
                "JIRA_API_TOKEN": "-",
            }
        }
      ,

	"gitlab": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@dangerusslee/gitlab-mcp-server"
      ],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "-",
        "GITLAB_API_URL": "https://git.epam.com/api/v4",
        "GITLAB_READ_ONLY_MODE": "false"
      }
    }
	},
	"inputs": []
}
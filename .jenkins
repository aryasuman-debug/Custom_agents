pipeline {
    agent any

    /*
     * This trigger runs the pipeline when GitHub sends a push event.
     * In Jenkins, this requires GitHub webhook configuration.
     */
    triggers {
        githubPush()
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    tools {
        maven 'Maven 3.9.8'
        jdk 'JDK-21'
    }

    parameters {
        /*
         * Docker image created by the developer pipeline.
         * Example:
         * 123456789012.dkr.ecr.ap-south-1.amazonaws.com/ai-services:45
         */
        string(
            name: 'DOCKER_IMAGE',
            defaultValue: 'ai-services:latest',
            description: 'Docker image from developer build'
        )

        /*
         * QA automation framework folder.
         * In your repo this should point to the QA automation project.
         */
        string(
            name: 'QA_DIR',
            defaultValue: 'qa-ai-services/test-folder',
            description: 'QA automation project directory'
        )

        /*
         * URL where the Docker container exposes the application.
         * For local Jenkins Docker execution, localhost is usually used.
         */
        string(
            name: 'BASE_URL',
            defaultValue: 'http://localhost:8080',
            description: 'Application URL for automation testing'
        )

        /*
         * Application port exposed inside the container.
         */
        string(
            name: 'APP_PORT',
            defaultValue: '8080',
            description: 'Application port'
        )

        /*
         * Run full regression only for final build or QA sign-off.
         */
        booleanParam(
            name: 'RUN_FULL_REGRESSION',
            defaultValue: false,
            description: 'Run full regression suite for final QA sign-off'
        )

        /*
         * Enable or disable sanity execution.
         */
        booleanParam(
            name: 'RUN_SANITY',
            defaultValue: true,
            description: 'Run sanity tests after smoke tests'
        )

        /*
         * Enable or disable partial regression execution.
         */
        booleanParam(
            name: 'RUN_PARTIAL_REGRESSION',
            defaultValue: true,
            description: 'Run partial regression after sanity tests'
        )

        /*
         * Retry count for flaky UI/API tests.
         * Keep this low. Retry is not a replacement for fixing unstable tests.
         */
        string(
            name: 'RETRY_COUNT',
            defaultValue: '1',
            description: 'Retry count for failed test execution'
        )

        /*
         * Browser value passed to Selenium framework.
         * Example: chrome, edge, firefox
         */
        string(
            name: 'BROWSER',
            defaultValue: 'chrome',
            description: 'Browser for UI automation'
        )

        /*
         * Optional execution scope tag.
         * Keep empty for generic execution.
         * Example: @ProductManagement or @US-005
         */
        string(
            name: 'EXECUTION_SCOPE_TAG',
            defaultValue: '',
            description: 'Optional Cucumber tag to limit sanity/partial regression scope'
        )
    }

    environment {
        CONTAINER_NAME = "qa-ai-services-${BUILD_NUMBER}"
        REPORT_DIR = "${params.QA_DIR}/target"
        CUCUMBER_REPORT_DIR = "${params.QA_DIR}/target/cucumber-reports"
        TESTNG_REPORT_DIR = "${params.QA_DIR}/target/surefire-reports"
        BUG_REPORT_DIR = "${params.QA_DIR}/target/bug-report"
    }

    stages {

        stage('Clean Workspace') {
            /*
             * Purpose:
             * Removes old files, reports, and build artifacts from previous runs.
             *
             * Input:
             * Jenkins workspace.
             *
             * Trigger:
             * Runs at the start of every QA pipeline execution.
             */
            steps {
                cleanWs()
            }
        }

        stage('Checkout QA Automation Code') {
            /*
             * Purpose:
             * Pulls the latest QA automation framework code from Git.
             *
             * Input:
             * Repository configured in Jenkins job.
             *
             * Trigger:
             * Runs after workspace cleanup.
             */
            steps {
                checkout scm
            }
        }

        stage('Pull Docker Image From Dev Build') {
            /*
             * Purpose:
             * Pulls the Docker image generated by the developer pipeline.
             * This ensures QA tests run against the same build artifact created by dev CI.
             *
             * Input:
             * DOCKER_IMAGE parameter.
             *
             * Trigger:
             * Runs after checkout.
             */
            steps {
                sh """
                    set -e
                    docker pull ${params.DOCKER_IMAGE}
                """
            }
        }

        stage('Start Application Container') {
            /*
             * Purpose:
             * Starts the application under test using the Docker image from dev.
             * The application becomes available through BASE_URL.
             *
             * Input:
             * DOCKER_IMAGE, APP_PORT, BASE_URL.
             *
             * Trigger:
             * Runs after Docker image is pulled successfully.
             */
            steps {
                sh """
                    set +e
                    docker stop ${env.CONTAINER_NAME} 2>/dev/null
                    docker rm ${env.CONTAINER_NAME} 2>/dev/null
                    set -e

                    docker run -d \
                      --name ${env.CONTAINER_NAME} \
                      -p ${params.APP_PORT}:${params.APP_PORT} \
                      ${params.DOCKER_IMAGE}
                """
            }
        }

        stage('Validate Application Availability') {
            /*
             * Purpose:
             * Waits until the application is reachable before starting automation.
             * If this fails, QA testing will not start because the app is not ready.
             *
             * Input:
             * BASE_URL.
             *
             * Trigger:
             * Runs after the application container starts.
             */
            steps {
                script {
                    retry(6) {
                        sleep 10
                        sh "curl -f ${params.BASE_URL}"
                    }
                }
            }
        }

        stage('Build QA Automation Project') {
            /*
             * Purpose:
             * Compiles the QA automation project.
             * This validates that TestNG, Cucumber, step definitions, and page objects compile properly.
             *
             * Input:
             * QA_DIR.
             *
             * Trigger:
             * Runs after application availability check passes.
             */
            steps {
                sh """
                    cd ${params.QA_DIR}
                    mvn -B clean compile
                """
            }
        }

        stage('Smoke Testing') {
            /*
             * Purpose:
             * Runs full-app basic checks using @smoke scenarios.
             * This is the first quality gate.
             * If smoke fails, the build is rejected and later stages do not run.
             *
             * Input:
             * Feature files containing @smoke tags.
             *
             * Trigger:
             * Runs after QA automation project compiles.
             */
            steps {
                script {
                    retry(params.RETRY_COUNT.toInteger()) {
                        sh """
                            cd ${params.QA_DIR}
                            mvn -B test \
                              -Dcucumber.filter.tags="@smoke" \
                              -DbaseUrl=${params.BASE_URL} \
                              -Dbrowser=${params.BROWSER}
                        """
                    }
                }
            }
            post {
                always {
                    junit testResults: "${params.QA_DIR}/**/target/surefire-reports/*.xml", allowEmptyResults: true
                }
            }
        }

        stage('Sanity Testing') {
            /*
             * Purpose:
             * Runs focused validation for recently added or changed features using @sanity scenarios.
             * This stage runs only after smoke passes.
             *
             * Input:
             * Feature files containing @sanity tags.
             * Optional EXECUTION_SCOPE_TAG can limit execution to an epic/user story/module tag.
             *
             * Trigger:
             * Runs after smoke testing passes and RUN_SANITY is true.
             */
            when {
                expression { return params.RUN_SANITY }
            }
            steps {
                script {
                    def tagExpression = params.EXECUTION_SCOPE_TAG?.trim()
                        ? "(${params.EXECUTION_SCOPE_TAG.trim()} and @sanity)"
                        : "@sanity"

                    retry(params.RETRY_COUNT.toInteger()) {
                        sh """
                            cd ${params.QA_DIR}
                            mvn -B test \
                              -Dcucumber.filter.tags="${tagExpression}" \
                              -DbaseUrl=${params.BASE_URL} \
                              -Dbrowser=${params.BROWSER}
                        """
                    }
                }
            }
            post {
                always {
                    junit testResults: "${params.QA_DIR}/**/target/surefire-reports/*.xml", allowEmptyResults: true
                }
            }
        }

        stage('Partial Regression') {
            /*
             * Purpose:
             * Runs selected regression coverage after sanity passes.
             * This is not full regression. It validates related impacted areas using @regression scenarios.
             *
             * Input:
             * Feature files containing @regression tags.
             * Optional EXECUTION_SCOPE_TAG can limit execution to an epic/user story/module tag.
             *
             * Trigger:
             * Runs after sanity testing passes and RUN_PARTIAL_REGRESSION is true.
             */
            when {
                expression { return params.RUN_PARTIAL_REGRESSION }
            }
            steps {
                script {
                    def tagExpression = params.EXECUTION_SCOPE_TAG?.trim()
                        ? "(${params.EXECUTION_SCOPE_TAG.trim()} and @regression)"
                        : "@regression and not @fullRegressionOnly"

                    retry(params.RETRY_COUNT.toInteger()) {
                        sh """
                            cd ${params.QA_DIR}
                            mvn -B test \
                              -Dcucumber.filter.tags="${tagExpression}" \
                              -DbaseUrl=${params.BASE_URL} \
                              -Dbrowser=${params.BROWSER}
                        """
                    }
                }
            }
            post {
                always {
                    junit testResults: "${params.QA_DIR}/**/target/surefire-reports/*.xml", allowEmptyResults: true
                }
            }
        }

        stage('Full Regression') {
            /*
             * Purpose:
             * Runs complete regression suite for final build validation.
             * This stage is used before final QA sign-off.
             *
             * Input:
             * Feature files containing @regression tags.
             *
             * Trigger:
             * Runs only when RUN_FULL_REGRESSION is true.
             */
            when {
                expression { return params.RUN_FULL_REGRESSION }
            }
            steps {
                script {
                    retry(params.RETRY_COUNT.toInteger()) {
                        sh """
                            cd ${params.QA_DIR}
                            mvn -B test \
                              -Dcucumber.filter.tags="@regression" \
                              -DbaseUrl=${params.BASE_URL} \
                              -Dbrowser=${params.BROWSER}
                        """
                    }
                }
            }
            post {
                always {
                    junit testResults: "${params.QA_DIR}/**/target/surefire-reports/*.xml", allowEmptyResults: true
                }
            }
        }

        stage('Publish Test Reports') {
            /*
             * Purpose:
             * Publishes TestNG XML reports and Cucumber HTML reports in Jenkins.
             *
             * Input:
             * Surefire/TestNG XML reports and Cucumber HTML reports from target folder.
             *
             * Trigger:
             * Runs after test execution stages.
             */
            steps {
                junit testResults: "${params.QA_DIR}/**/target/surefire-reports/*.xml", allowEmptyResults: true

                publishHTML([
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: "${params.QA_DIR}/target/cucumber-reports",
                    reportFiles: 'index.html',
                    reportName: 'Cucumber BDD Report'
                ])
            }
        }

        stage('Test Report Agent') {
            /*
             * Purpose:
             * Triggers the AI Test Report Agent.
             * The agent reads TestNG/Cucumber reports and creates a readable test execution summary.
             *
             * Input:
             * QA target folder containing XML, JSON, HTML, and logs.
             *
             * Trigger:
             * Runs after Jenkins publishes reports.
             */
            steps {
                sh """
                    if [ -f agents/test_report_agent.py ]; then
                        python agents/test_report_agent.py ${params.QA_DIR}/target
                    else
                        echo "Test Report Agent not found. Skipping agent execution."
                    fi
                """
            }
        }

        stage('Bug Report Agent') {
            /*
             * Purpose:
             * Triggers the AI Bug Report Agent.
             * The agent analyzes failed tests and generates structured bug reports.
             *
             * Input:
             * TestNG/Cucumber report outputs from QA target folder.
             *
             * Trigger:
             * Runs after Test Report Agent.
             */
            steps {
                sh """
                    if [ -f agents/bug_report_agent.py ]; then
                        python agents/bug_report_agent.py ${params.QA_DIR}/target
                    else
                        echo "Bug Report Agent not found. Skipping agent execution."
                    fi
                """
            }
        }

        stage('QA Sign-off') {
            /*
             * Purpose:
             * Marks the build as QA-approved only when previous quality gates pass.
             *
             * Input:
             * Successful smoke, sanity, partial regression, and optional full regression results.
             *
             * Trigger:
             * Runs only if all previous required stages pass.
             */
            when {
                expression { return params.RUN_FULL_REGRESSION }
            }
            steps {
                echo "QA sign-off completed. Build is ready from QA side."
            }
        }

        stage('Archive QA Artifacts') {
            /*
             * Purpose:
             * Archives all QA outputs for traceability and debugging.
             *
             * Input:
             * Reports, logs, screenshots, JSON files, XML files, and bug reports.
             *
             * Trigger:
             * Runs near the end of pipeline.
             */
            steps {
                archiveArtifacts artifacts: "${params.QA_DIR}/target/**/*", allowEmptyArchive: true, fingerprint: true
            }
        }
    }

    post {
        success {
            echo "QA pipeline completed successfully."
        }

        unstable {
            echo "QA pipeline completed with test failures."
        }

        failure {
            echo "QA pipeline failed. Build should not be promoted."
        }

        always {
            sh """
                docker stop ${env.CONTAINER_NAME} 2>/dev/null || true
                docker rm ${env.CONTAINER_NAME} 2>/dev/null || true
            """
            cleanWs()
        }
    }
}
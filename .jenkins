pipeline {
    agent any

    triggers {
        githubPush()
    }

    options {
        skipDefaultCheckout(true)
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    tools {
        maven 'Maven 3.9.8'
        jdk 'JDK-21'
    }

    parameters {
        booleanParam(name: 'USE_DOCKER', defaultValue: false, description: 'Use Docker image when available')
        booleanParam(name: 'RUN_TESTS', defaultValue: false, description: 'Run tests only when application is available')

        string(name: 'DOCKER_IMAGE', defaultValue: 'ai-services:latest', description: 'Docker image from dev build')
        string(name: 'QA_DIR', defaultValue: 'qa-ai-services/test-folder', description: 'QA automation project directory')
        string(name: 'BASE_URL', defaultValue: 'http://localhost:8080', description: 'Application URL')
        string(name: 'APP_PORT', defaultValue: '8080', description: 'Application port')

        booleanParam(name: 'RUN_SANITY', defaultValue: true, description: 'Run sanity tests')
        booleanParam(name: 'RUN_PARTIAL_REGRESSION', defaultValue: true, description: 'Run partial regression')
        booleanParam(name: 'RUN_FULL_REGRESSION', defaultValue: false, description: 'Run full regression')

        string(name: 'RETRY_COUNT', defaultValue: '1', description: 'Retry count')
        string(name: 'BROWSER', defaultValue: 'chrome', description: 'Browser')
        string(name: 'EXECUTION_SCOPE_TAG', defaultValue: '', description: 'Optional Cucumber tag')
    }

    environment {
        CONTAINER_NAME = "qa-ai-services-${BUILD_NUMBER}"
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout QA Automation Code') {
            steps {
                checkout scm
            }
        }

        stage('Docker Skipped Or Started') {
            steps {
                script {
                    if (params.USE_DOCKER) {
                        bat """
                            docker pull ${params.DOCKER_IMAGE}

                            docker stop ${env.CONTAINER_NAME} 2>NUL || echo No old container
                            docker rm ${env.CONTAINER_NAME} 2>NUL || echo No old container

                            docker run -d --name ${env.CONTAINER_NAME} -p ${params.APP_PORT}:${params.APP_PORT} ${params.DOCKER_IMAGE}
                        """
                    } else {
                        echo "Docker is disabled for now. Skipping Docker pull and container start."
                    }
                }
            }
        }

        stage('Validate Application Availability') {
            when {
                expression { return params.RUN_TESTS }
            }
            steps {
                script {
                    retry(6) {
                        sleep 10
                        bat "curl -f ${params.BASE_URL}"
                    }
                }
            }
        }

        stage('Build QA Automation Project') {
            steps {
                bat """
                    cd ${params.QA_DIR}
                    mvn -B clean compile
                """
            }
        }

        stage('Smoke Testing') {
            when {
                expression { return params.RUN_TESTS }
            }
            steps {
                script {
                    retry(params.RETRY_COUNT.toInteger()) {
                        bat """
                            cd ${params.QA_DIR}
                            mvn -B test -Dcucumber.filter.tags="@smoke" -DbaseUrl=${params.BASE_URL} -Dbrowser=${params.BROWSER}
                        """
                    }
                }
            }
            post {
                always {
                    junit testResults: "${params.QA_DIR}/**/target/surefire-reports/*.xml", allowEmptyResults: true
                }
            }
        }

        stage('Sanity Testing') {
            when {
                expression { return params.RUN_TESTS && params.RUN_SANITY }
            }
            steps {
                script {
                    def tagExpression = params.EXECUTION_SCOPE_TAG?.trim()
                        ? "(${params.EXECUTION_SCOPE_TAG.trim()} and @sanity)"
                        : "@sanity"

                    retry(params.RETRY_COUNT.toInteger()) {
                        bat """
                            cd ${params.QA_DIR}
                            mvn -B test -Dcucumber.filter.tags="${tagExpression}" -DbaseUrl=${params.BASE_URL} -Dbrowser=${params.BROWSER}
                        """
                    }
                }
            }
            post {
                always {
                    junit testResults: "${params.QA_DIR}/**/target/surefire-reports/*.xml", allowEmptyResults: true
                }
            }
        }

        stage('Partial Regression') {
            when {
                expression { return params.RUN_TESTS && params.RUN_PARTIAL_REGRESSION }
            }
            steps {
                script {
                    def tagExpression = params.EXECUTION_SCOPE_TAG?.trim()
                        ? "(${params.EXECUTION_SCOPE_TAG.trim()} and @regression)"
                        : "@regression and not @fullRegressionOnly"

                    retry(params.RETRY_COUNT.toInteger()) {
                        bat """
                            cd ${params.QA_DIR}
                            mvn -B test -Dcucumber.filter.tags="${tagExpression}" -DbaseUrl=${params.BASE_URL} -Dbrowser=${params.BROWSER}
                        """
                    }
                }
            }
            post {
                always {
                    junit testResults: "${params.QA_DIR}/**/target/surefire-reports/*.xml", allowEmptyResults: true
                }
            }
        }

        stage('Full Regression') {
            when {
                expression { return params.RUN_TESTS && params.RUN_FULL_REGRESSION }
            }
            steps {
                script {
                    retry(params.RETRY_COUNT.toInteger()) {
                        bat """
                            cd ${params.QA_DIR}
                            mvn -B test -Dcucumber.filter.tags="@regression" -DbaseUrl=${params.BASE_URL} -Dbrowser=${params.BROWSER}
                        """
                    }
                }
            }
            post {
                always {
                    junit testResults: "${params.QA_DIR}/**/target/surefire-reports/*.xml", allowEmptyResults: true
                }
            }
        }

        stage('Publish Test Reports') {
            steps {
                junit testResults: "${params.QA_DIR}/**/target/surefire-reports/*.xml", allowEmptyResults: true

                publishHTML([
                    allowMissing: true,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: "${params.QA_DIR}/target/cucumber-reports",
                    reportFiles: 'index.html',
                    reportName: 'Cucumber BDD Report'
                ])
            }
        }

        stage('Test Report Agent') {
            steps {
                bat """
                    if exist agents\\test_report_agent.py (
                        python agents\\test_report_agent.py ${params.QA_DIR}\\target
                    ) else (
                        echo Test Report Agent not found. Skipping.
                    )
                """
            }
        }

        stage('Bug Report Agent') {
            steps {
                bat """
                    if exist agents\\bug_report_agent.py (
                        python agents\\bug_report_agent.py ${params.QA_DIR}\\target
                    ) else (
                        echo Bug Report Agent not found. Skipping.
                    )
                """
            }
        }

        stage('Archive QA Artifacts') {
            steps {
                archiveArtifacts artifacts: "${params.QA_DIR}/target/**/*", allowEmptyArchive: true, fingerprint: true
            }
        }
    }

    post {
        always {
            script {
                if (params.USE_DOCKER) {
                    bat """
                        docker stop ${env.CONTAINER_NAME} 2>NUL || echo No container to stop
                        docker rm ${env.CONTAINER_NAME} 2>NUL || echo No container to remove
                    """
                } else {
                    echo "Docker cleanup skipped."
                }
            }

            cleanWs()
        }

        success {
            echo "QA pipeline completed successfully."
        }

        unstable {
            echo "QA pipeline completed with test failures."
        }

        failure {
            echo "QA pipeline failed."
        }
    }
}